# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채우세요.
# cp .env.local.example .env.local

# --- Supabase (대시보드 → Connect → App Frameworks, 또는 Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# (구버전 프로젝트라면 위 대신 NEXT_PUBLIC_SUPABASE_ANON_KEY 를 써도 동작합니다)

# --- LUXIA (Saltlux) — 서버 전용. 절대 NEXT_PUBLIC 붙이지 말 것 ---
# 발급: platform.luxiacloud.com → Dashboard → API Keys → Create New API Key
LUXIA_API_KEY=your-luxia-api-key
LUXIA_MODEL=luxia3-llm-8b-0731
